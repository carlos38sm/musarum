# Copia este fichero a keystore.properties (al lado) y rellena.
# NO lo subas a git — está en .gitignore.
#
# Para generar el keystore (una vez, guarda el .jks en sitio seguro
# — si lo pierdes, no puedes publicar updates de la misma app):
#
#   keytool -genkey -v -keystore ~/.musarum/release.jks \
#     -alias musarum -keyalg RSA -keysize 2048 -validity 10950
#
# storeFile = ruta relativa a la raíz del proyecto, o absoluta.
storeFile=../../.musarum/release.jks
storePassword=CAMBIAME
keyAlias=musarum
keyPassword=CAMBIAME
