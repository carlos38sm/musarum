        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.musarum.mobile"
            android:targetClass="com.musarum.mobile.MainActivity">
            <extra
                android:name="musarum.shortcut"
                android:value="search" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="songs"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_songs"
        android:shortcutShortLabel="@string/shortcut_songs_short"
        android:shortcutLongLabel="@string/shortcut_songs_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.musarum.mobile"
            android:targetClass="com.musarum.mobile.MainActivity">
            <extra
                android:name="musarum.shortcut"
                android:value="songs" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

</shortcuts>
