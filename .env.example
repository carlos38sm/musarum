POSTGRES_DB=BD_NAME
POSTGRES_USER=USER_DB
POSTGRES_PASSWORD=PASSWORD_DB

JWT_SECRET=GENERATE_ONE_JWT_SECRET_KEY
JWT_EXPIRATION=3600000

MUSARUM_OWNER_NICK=owner
MUSARUM_OWNER_PASSWORD=changeThisPassword123

# Ruta HOST (fuera del contenedor) a la carpeta paraguas. Debe contener la
# música y las subcarpetas _covers/_lyrics/_videos/_profilepictures.
MUSARUM_MUSIC_PATH=C:/Users/.../.../...

# Opcional: si no corres Emendatium como contenedor hermano, bórralo o
# apunta a su URL. Si usas el docker-compose, el valor queda sobreescrito
# por SPRING_DATASOURCE_URL a http://emendatium:8081.
EMENDATIUM_BASE_URL=http://emendatium:8081

# Canal de releases para el diálogo "Actualizar" del móvil (opcional).
# Cuando publiques una APK nueva, actualiza LATEST + URL y reinicia el
# backend. MUSARUM_APK_MANDATORY=true fuerza al usuario a actualizar.
MUSARUM_APK_LATEST=
MUSARUM_APK_URL=
MUSARUM_APK_MANDATORY=false

# Para los tags del docker-compose + imágenes GHCR:
GITHUB_OWNER=carlos